<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.1">
  <display-name>Star Hub</display-name>
  <distributable/>
  <filter><filter-name>security</filter-name><filter-class>com.starhub.SecurityFilter</filter-class></filter>
  <filter-mapping><filter-name>security</filter-name><url-pattern>/*</url-pattern></filter-mapping>
  <filter><filter-name>cluster</filter-name><filter-class>com.starhub.ClusterFilter</filter-class></filter>
  <filter-mapping><filter-name>cluster</filter-name><url-pattern>/api/account</url-pattern></filter-mapping>
  <filter-mapping><filter-name>cluster</filter-name><url-pattern>/api/workspace</url-pattern></filter-mapping>
  <servlet><servlet-name>workspace</servlet-name><servlet-class>com.starhub.WorkspaceServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>workspace</servlet-name><url-pattern>/api/workspace</url-pattern></servlet-mapping>
  <servlet><servlet-name>account</servlet-name><servlet-class>com.starhub.AccountServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>account</servlet-name><url-pattern>/api/account</url-pattern></servlet-mapping>
  <servlet><servlet-name>guestSession</servlet-name><servlet-class>com.starhub.GuestSessionServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>guestSession</servlet-name><url-pattern>/api/guest-session</url-pattern></servlet-mapping>
  <servlet><servlet-name>api</servlet-name><servlet-class>com.starhub.ApiServlet</servlet-class><load-on-startup>1</load-on-startup></servlet>
  <servlet-mapping><servlet-name>api</servlet-name><url-pattern>/api/*</url-pattern></servlet-mapping>
  <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
  <session-config><session-timeout>10</session-timeout><cookie-config><http-only>true</http-only><secure>true</secure></cookie-config></session-config>
</web-app>
