<Window
    x:Class="StarHub.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Star Hub">
    <Grid x:Name="Shell" Background="{ThemeResource WorkspaceBrush}" SizeChanged="ShellSizeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewShortcut" />
        </Grid.KeyboardAccelerators>
        <SplitView x:Name="Workspace" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="246"
                   PaneBackground="Transparent">
            <SplitView.Pane>
              <Border Background="{ThemeResource SideRailBrush}" Margin="9,9,0,9" CornerRadius="21">
                <Grid Padding="14,16,14,13" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="✳" Foreground="{ThemeResource BrandBrush}" FontSize="21" FontFamily="Segoe UI Symbol"
                                   VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="Star Hub" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                        <ComboBox x:Name="ProjectPicker" HorizontalAlignment="Stretch" SelectionChanged="ProjectChanged"
                                  AutomationProperties.Name="Project" AutomationProperties.AutomationId="ProjectPicker" />
                        <Button x:Name="ManageProjects" Grid.Column="1" Click="ProjectsClicked" Style="{StaticResource SubtleButtonStyle}"
                                AutomationProperties.Name="Manage projects" ToolTipService.ToolTip="Manage projects">
                            <SymbolIcon Symbol="Folder" />
                        </Button>
                    </Grid>
                    <Button x:Name="NewButton" Grid.Row="2" Click="NewClicked" HorizontalAlignment="Stretch" BorderThickness="0"
                            HorizontalContentAlignment="Left" AutomationProperties.AutomationId="NewChat">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock x:Name="NewConversationLabel" Text="New conversation" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="HistoryFilter" Grid.Row="3" PlaceholderText="Find a conversation"
                             AutomationProperties.Name="Find a conversation" TextChanged="SearchHistoryChanged" />
                    <ListView x:Name="History" Grid.Row="4" SelectionChanged="HistoryChanged"
                              AutomationProperties.Name="Conversations" AutomationProperties.AutomationId="History">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="5" Spacing="4">
                        <Button x:Name="SettingsButton" Style="{StaticResource SubtleButtonStyle}" Click="SettingsClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                AutomationProperties.AutomationId="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Setting" /><TextBlock x:Name="Settings" Text="Settings" /></StackPanel>
                            <Button.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="ModelSettings" Text="Model and reasoning…" Click="ModelSettingsClicked" />
                                    <MenuFlyoutItem x:Name="LocalMemory" Text="Local memory" Click="MemoryClicked" />
                                    <MenuFlyoutItem x:Name="ScheduledTasks" Text="Scheduled tasks" Click="TasksClicked" AutomationProperties.AutomationId="Tasks" />
                                </MenuFlyout>
                            </Button.ContextFlyout>
                        </Button>
                        <Button x:Name="DesktopAccountButton" Style="{StaticResource SubtleButtonStyle}" Click="DesktopAccountClicked"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="DesktopAccount">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <SymbolIcon Symbol="Contact" />
                                <TextBlock x:Name="DesktopAccountLabel" Grid.Column="1" Text="Sign in to Star Hub"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
              </Border>
            </SplitView.Pane>
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Button x:Name="ToggleConversationSidebar" Click="ToggleSidebar" Style="{StaticResource SubtleButtonStyle}"
                                AutomationProperties.Name="Toggle conversation sidebar" ToolTipService.ToolTip="Conversations">
                            <SymbolIcon Symbol="GlobalNavigationButton" />
                        </Button>
                        <TextBlock x:Name="ChatTitle" Grid.Column="1" Text="New conversation" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="ConversationActions" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}"
                                Visibility="Collapsed" AutomationProperties.Name="Conversation actions"
                                AutomationProperties.AutomationId="ConversationActions">
                            <FontIcon Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="RenameConversation" Text="Rename conversation…" Click="RenameConversationClicked"
                                                    AutomationProperties.AutomationId="RenameConversation" />
                                    <MenuFlyoutItem x:Name="ExportConversation" Text="Export conversation…" Click="ExportClicked" />
                                    <MenuFlyoutItem x:Name="DeleteConversation" Text="Delete conversation…" Click="DeleteClicked"
                                                    AutomationProperties.AutomationId="DeleteConversation" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="Device" Grid.Column="3" Click="DeviceMonitorClicked" Content="Device" Style="{StaticResource SubtleButtonStyle}"
                                AutomationProperties.Name="Device monitor" AutomationProperties.AutomationId="DeviceMonitor"
                                ToolTipService.ToolTip="Show live system and hardware readings" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="Transcript" AutomationProperties.AutomationId="Transcript" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled" SizeChanged="TranscriptSizeChanged"
                              VerticalScrollBarVisibility="Auto" Padding="24,24,24,14">
                    <Grid x:Name="TranscriptContent" MaxWidth="780" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <StackPanel x:Name="MessageLog" Spacing="28" />
                    </Grid>
                </ScrollViewer>
                <Grid x:Name="Welcome" Grid.Row="1" Margin="16,0" RowDefinitions="*,Auto,*">
                    <TextBlock Text="✳" Foreground="{ThemeResource BrandBrush}" FontSize="40" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="0,0,0,8" FontFamily="Segoe UI Symbol"
                               AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="StartAConversation" Grid.Row="1" AutomationProperties.AutomationId="WelcomeHeading"
                               Text="What would you like to do?" TextWrapping="Wrap" TextAlignment="Center"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock x:Name="AskAQuestionOrAddAFile"
                               Text="Type or speak. Try “open Notepad”." TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="ResumeLearning" Visibility="Collapsed" HorizontalAlignment="Center" AutomationProperties.AutomationId="ResumeLearning"
                            Click="ResumeLearningClicked" CornerRadius="12" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="ComposerArea" Grid.Row="2" Padding="20,8,20,18">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Stretch" Spacing="8">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ChatStatus" />
                        <Border CornerRadius="21" Background="{ThemeResource ComposerBrush}"
                                BorderBrush="{ThemeResource RuleBrush}" BorderThickness="1" Padding="10,9">
                            <StackPanel Spacing="6">
                                <Grid x:Name="FileRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed">
                                    <TextBlock x:Name="FileLabel" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button x:Name="RemoveAttachment" Grid.Column="1" Click="DetachClicked" AutomationProperties.Name="Remove attachment" Style="{StaticResource SubtleButtonStyle}">
                                        <SymbolIcon Symbol="Cancel" />
                                    </Button>
                                </Grid>
                                <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap"
                                         PreviewKeyDown="ComposerKeyDown" TextCompositionStarted="ComposerCompositionStarted"
                                         TextCompositionEnded="ComposerCompositionEnded" MaxHeight="150" MinHeight="55"
                                         BorderThickness="0" Background="Transparent" PlaceholderText="Type a message or tell your PC what to do"
                                         MaxLength="30000" TextChanged="ComposerChanged"
                                         AutomationProperties.Name="Message" AutomationProperties.AutomationId="Composer">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    </TextBox.Resources>
                                </TextBox>
                                <Canvas x:Name="VoiceWaveform" Height="34" Visibility="Collapsed" IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="VoiceTranscript" Visibility="Collapsed" TextWrapping="Wrap"
                                           MaxLines="4" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="VoiceTranscript" />
                                <Grid x:Name="ComposerTools" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="6" SizeChanged="ComposerToolsSizeChanged">
                                    <StackPanel x:Name="ComposerOptions" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Left">
                                        <Button x:Name="AttachButton" Click="AttachClicked" Style="{StaticResource SubtleButtonStyle}"
                                                AutomationProperties.Name="Attach a file" ToolTipService.ToolTip="Attach a file">
                                            <SymbolIcon Symbol="Attach" />
                                        </Button>
                                        <CheckBox x:Name="WebSearch" Content="Search the web" MinWidth="0" Padding="4,0,5,0"
                                                  VerticalAlignment="Center" AutomationProperties.AutomationId="WebSearch" />
                                        <ToggleButton x:Name="OperateComputer" Content="Operate this PC" CornerRadius="12" Padding="9,5"
                                                      VerticalAlignment="Center" Click="OperateComputerClicked"
                                                      AutomationProperties.AutomationId="OperateComputer" />
                                    </StackPanel>
                                    <StackPanel x:Name="ComposerActions" Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
                                        <Button x:Name="VoiceInput" Click="VoiceInputClicked" CornerRadius="15"
                                                Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="VoiceInput"
                                                AutomationProperties.Name="Start voice input" ToolTipService.ToolTip="Start voice input">
                                            <FontIcon x:Name="VoiceInputIcon" Glyph="&#xE720;" />
                                        </Button>
                                        <Button x:Name="SendButton" Style="{StaticResource AccentButtonStyle}" Click="SendClicked" CornerRadius="15"
                                                AutomationProperties.Name="Send message" AutomationProperties.AutomationId="Send"
                                                ToolTipService.ToolTip="Send (Enter)">
                                            <SymbolIcon Symbol="Send" />
                                        </Button>
                                        <Button x:Name="StopButton" Click="StopClicked" Visibility="Collapsed" CornerRadius="15"
                                                AutomationProperties.Name="Stop">
                                            <SymbolIcon Symbol="Stop" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </SplitView>
    </Grid>
</Window>
